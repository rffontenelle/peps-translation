msgid ""
"A set of rules for normalizing ``Project-URL`` labels during index-side "
"processing;"
msgstr ""

#: ../../peps/peps/pep-0753.rst:171
msgid ""
"A set of \"well-known\" normalized label values that indices may specialize "
"URL presentation for."
msgstr ""

