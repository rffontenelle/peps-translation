#: ../../peps/peps/topic/typing.rst:302
msgid "PEP Types Key"
msgstr ""

#: ../../peps/peps/topic/typing.rst:304
msgid ""
"**I** --- *Informational*: Non-normative PEP containing background, "
"guidelines or other information relevant to the Python ecosystem"
msgstr ""

#: ../../peps/peps/topic/typing.rst:306
msgid ""
"**P** --- *Process*: Normative PEP describing or proposing a change to a "
"Python community process, workflow or governance"
msgstr ""

#: ../../peps/peps/topic/typing.rst:308
msgid ""
"**S** --- *Standards Track*: Normative PEP with a new feature for Python, "
"implementation change for CPython or interoperability standard for the "
"ecosystem"
msgstr ""

#: ../../peps/peps/topic/typing.rst:310
msgid ":pep:`More info in PEP 1 <1#pep-types>`."
msgstr ""

#: ../../peps/peps/topic/typing.rst:313
msgid "PEP Status Key"
msgstr ""

#: ../../peps/peps/topic/typing.rst:315
msgid "**A** --- *Accepted*: Normative proposal accepted for implementation"
msgstr ""

#: ../../peps/peps/topic/typing.rst:317
msgid ""
"**A** --- *Active*: Currently valid informational guidance, or an in-use "
"process"
msgstr ""

#: ../../peps/peps/topic/typing.rst:319
msgid ""
"**D** --- *Deferred*: Inactive draft that may be taken up again at a later "
"time"
msgstr ""

#: ../../peps/peps/topic/typing.rst:321
msgid ""
"**<No letter>** --- *Draft*: Proposal under active discussion and revision"
msgstr ""

#: ../../peps/peps/topic/typing.rst:323
msgid ""
"**F** --- *Final*: Accepted and implementation complete, or no longer active"
msgstr ""

#: ../../peps/peps/topic/typing.rst:325
msgid ""
"**P** --- *Provisional*: Provisionally accepted but additional feedback "
"needed"
msgstr ""

#: ../../peps/peps/topic/typing.rst:327
msgid "**R** --- *Rejected*: Formally declined and will not be accepted"
msgstr ""

#: ../../peps/peps/topic/typing.rst:329
msgid "**S** --- *Superseded*: Replaced by another succeeding PEP"
msgstr ""

#: ../../peps/peps/topic/typing.rst:331
msgid "**W** --- *Withdrawn*: Removed from consideration by sponsor or authors"
msgstr ""

#: ../../peps/peps/topic/typing.rst:333
msgid ":pep:`More info in PEP 1 <1#pep-review-resolution>`."
msgstr ""
