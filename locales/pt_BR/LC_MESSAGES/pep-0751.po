#: ../../peps/peps/pep-0751.rst:443
msgid "A path to the source tree, which may be absolute or relative."
msgstr ""

#: ../../peps/peps/pep-0751.rst:444 ../../peps/peps/pep-0751.rst:513
msgid "If the path is relative it MUST be relative to the lock file."
msgstr ""

#: ../../peps/peps/pep-0751.rst:445
msgid ""
"The path may either be to a directory, file archive, or VCS checkout if "
"``vcs`` if is specified."
msgstr ""

#: ../../peps/peps/pep-0751.rst:450
msgid "``packages.source-tree.url``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:452
msgid "Required if ``path`` is not set"
msgstr ""

#: ../../peps/peps/pep-0751.rst:454
msgid ""
"A URL to a file archive containing the source tree, or a VCS checkout if "
"``vcs`` is specified."
msgstr ""

#: ../../peps/peps/pep-0751.rst:459
msgid "``packages.source-tree.commit``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:461
msgid "Required if ``vcs`` is set"
msgstr ""

#: ../../peps/peps/pep-0751.rst:463
msgid ""
"The commit ID for the repository which represents the package and version."
msgstr ""

#: ../../peps/peps/pep-0751.rst:464
msgid ""
"The value MUST be immutable for the VCS for security purposes (e.g. no Git "
"tags)."
msgstr ""

#: ../../peps/peps/pep-0751.rst:469
msgid "``packages.source-tree.size``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:472 ../../peps/peps/pep-0751.rst:529
msgid "Integer"
msgstr ""

#: ../../peps/peps/pep-0751.rst:473
msgid "The size in bytes for the source tree if it is a file."
msgstr ""

#: ../../peps/peps/pep-0751.rst:474 ../../peps/peps/pep-0751.rst:531
msgid "Installers MUST verify the file size matches this value."
msgstr ""

#: ../../peps/peps/pep-0751.rst:478
msgid "``packages.source-tree.hash``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:480
msgid "Required if ``url`` or ``path`` points to a file"
msgstr ""

#: ../../peps/peps/pep-0751.rst:482 ../../peps/peps/pep-0751.rst:538
msgid ""
"The hash value of the file contents using the hash algorithm specified by "
"``hash-algorithm``."
msgstr ""

#: ../../peps/peps/pep-0751.rst:484 ../../peps/peps/pep-0751.rst:540
msgid "Installers MUST verify the hash matches the file."
msgstr ""

#: ../../peps/peps/pep-0751.rst:488
msgid "``[packages.sdist]``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:492
msgid ""
"The location of a source distribution as specified by :ref:`packaging:source-"
"distribution-format`."
msgstr ""

#: ../../peps/peps/pep-0751.rst:494 ../../peps/peps/pep-0751.rst:550
msgid "Lockers SHOULD write the table inline."
msgstr ""

#: ../../peps/peps/pep-0751.rst:495
msgid "Support for source distributions by installers is optional."
msgstr ""

#: ../../peps/peps/pep-0751.rst:500
msgid "``packages.sdist.url``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:502
msgid "Optional; mutually-exclusive with ``path``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:504
msgid "The URL to the file."
msgstr ""

#: ../../peps/peps/pep-0751.rst:508
msgid "``packages.sdist.path``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:510
msgid "Optional; mutually-exclusive with ``url``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:512
msgid "A path to the file, which may be absolute or relative."
msgstr ""

#: ../../peps/peps/pep-0751.rst:517
msgid "``packages.sdist.upload-time``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:519
msgid "Optional and only applicable when ``url`` is specified"
msgstr ""

#: ../../peps/peps/pep-0751.rst:520
msgid "Offset date time"
msgstr ""

#: ../../peps/peps/pep-0751.rst:521
msgid ""
"The upload date and time of the file as specified by a valid ISO 8601 date/"
"time string for the ``.files[].\"upload-time\"`` field in the JSON version "
"of :ref:`packaging:simple-repository-api`."
msgstr ""

#: ../../peps/peps/pep-0751.rst:526
msgid "``packages.sdist.size``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:530
msgid "The size of the file in bytes."
msgstr ""

#: ../../peps/peps/pep-0751.rst:535
msgid "``packages.sdist.hash``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:544
msgid "``[[packages.wheels]]``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:548
msgid ""
"For recording the wheel files as specified by :ref:`packaging:binary-"
"distribution-format` for the package version."
msgstr ""

#: ../../peps/peps/pep-0751.rst:551
msgid "Lockers SHOULD sort the array values lexicographically by ``tag``."
msgstr ""

#: ../../peps/peps/pep-0751.rst:555
msgid "``packages.wheels.tags``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:557
msgid "Array of string"
msgstr ""

#: ../../peps/peps/pep-0751.rst:558
msgid ""
"The uncompressed tag portion of the wheel file: Python, ABI, and platform."
msgstr ""

#: ../../peps/peps/pep-0751.rst:559
msgid ""
"Lockers MUST make sure the tag values are unique within the ``packages."
"wheels`` array."
msgstr ""

#: ../../peps/peps/pep-0751.rst:564
