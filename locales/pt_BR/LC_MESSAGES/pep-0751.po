msgid "``packages.wheels.path``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:580
msgid "See ``packages.sdist.path``."
msgstr ""

#: ../../peps/peps/pep-0751.rst:584
msgid "``packages.wheels.upload-time``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:586
msgid "See ``packages.sdist.upload-time``."
msgstr ""

#: ../../peps/peps/pep-0751.rst:590
msgid "``packages.wheels.size``"
msgstr ""

#: ../../peps/peps/pep-0751.rst:592
msgid "See ``packages.sdist.size``."
msgstr ""

