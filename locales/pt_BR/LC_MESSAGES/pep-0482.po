#: ../../peps/peps/pep-0482.rst:72
msgid "Existing Approaches in Other Languages"
msgstr ""

#: ../../peps/peps/pep-0482.rst:75
msgid "ActionScript"
msgstr ""

#: ../../peps/peps/pep-0482.rst:77
msgid ""
"ActionScript__ is a class-based, single inheritance, object-oriented "
"superset of ECMAScript.  It supports interfaces and strong runtime-checked "
"static typing.  Compilation supports a “strict dialect” where type "
"mismatches are reported at compile-time."
msgstr ""

