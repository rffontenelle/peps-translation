msgstr ""

#: ../../peps/peps/pep-0756.rst:56
msgid "``PyUnicode_2BYTE_DATA()`` for ``PyUnicode_2BYTE_KIND``."
msgstr ""

#: ../../peps/peps/pep-0756.rst:57
msgid "``PyUnicode_4BYTE_DATA()`` for ``PyUnicode_4BYTE_KIND``."
msgstr ""

#: ../../peps/peps/pep-0756.rst:59
msgid ""
